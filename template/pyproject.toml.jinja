[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "{{ model_slug | replace('_', '-') }}"
version = "0.1.0"
description = "{{ model_description }}"
readme = "README.md"
requires-python = ">={{ python_version }}"
license = { text = "MIT" }
authors = [{ name = "{{ author_name }}", email = "{{ author_email }}" }]
dependencies = [
  # Core MEDS ecosystem (the vendored `meds_model_base` package builds on these).
  "meds~=0.4",
  "meds-torch-data[lightning]~=0.9.0",
  "MEDS-transforms>=0.6.7",
  "meds-evaluation~=0.0.6",
  "hydra-core>=1.3,<2",
  "lightning>=2.5,<3",
  "torch>=2.4",
  "torchmetrics>=1.0",
  "polars>=1.30,<2",
  "pyarrow",
  "numpy",
]

[project.optional-dependencies]
# The template never parses ACES: tasks arrive as materialized labels (see `meds-dev-task`). A model
# that chooses to interpret a task definition itself can install this.
aces = ["es-aces>=0.7.3"]
{% if use_wandb %}wandb = ["wandb"]
{% endif %}{% if use_mlflow %}mlflow = ["mlflow", "psutil", "pynvml"]
{% endif %}

[project.scripts]
"meds-model" = "{{ model_slug }}.__main__:cli"
# Packaging helper, not one of the five commands: copies `model.yaml` into a MEDS-DEV checkout.
"meds-model-add-to-meds-dev" = "meds_model_base.meds_dev:main"

[dependency-groups]
dev = [
  "pytest>=8",
  "pytest-cov",
  "meds-testing-helpers~=0.3.1",
  "hypothesis",
  "ruff",
  "pre-commit<4",
  "yaml_to_disk",
  "pretty-print-directory",
]

[tool.hatch.build.targets.wheel]
packages = ["src/{{ model_slug }}", "src/meds_model_base"]

# Ship the packaged Hydra configs inside the wheel.
[tool.hatch.build.targets.wheel.force-include]
"src/{{ model_slug }}/configs" = "{{ model_slug }}/configs"

[tool.ruff]
line-length = 110
target-version = "py{{ python_version | replace('.', '') }}"

[tool.ruff.lint]
select = ["E", "F", "I", "UP", "B", "C4", "SIM", "RUF", "N"]
ignore = ["RUF022"]  # `__all__` is grouped by concern with comments, not alphabetized

[tool.ruff.lint.per-file-ignores]
"__init__.py" = ["F401"]  # re-exports

[tool.ruff.lint.pep8-naming]
# `F` (torch.nn.functional), `L` (lightning.pytorch), and MEDS-cased names are ecosystem conventions.
extend-ignore-names = ["F", "L", "*MEDS*"]

[tool.ruff.lint.isort]
# The vendored contract sorts as a third-party import (before your own first-party package), so import
# ordering is stable regardless of the model slug.
known-third-party = ["meds_model_base"]

[tool.pytest.ini_options]
addopts = ["--color=yes", "--doctest-modules", "--doctest-glob=*.md"]
# ELLIPSIS lets docstring examples elide long error messages; NORMALIZE_WHITESPACE lets them wrap.
doctest_optionflags = ["ELLIPSIS", "NORMALIZE_WHITESPACE"]
testpaths = ["src", "tests"]
markers = [
  "slow: designed-signal learnability test (deselect with '-m \"not slow\"')",
  "meds_dev: end-to-end through MEDS-DEV; also marked slow, and skips unless MEDS_DEV_DIR or MEDS_DEV_CLONE is set",
]
