## MEDS-DEV descriptor for {{ model_name }}. This retains the established command-slot interface.
metadata:
  description: "{{ model_description }}"
  contacts:
    - name: "{{ author_name }}"
      email: "{{ author_email }}"

commands:
{% if profile in ['finetune', 'probe', 'zero_shot_direct', 'zero_shot_materialized'] %}  unsupervised:
    train: |-
      meds-model preprocess_data external_meds_dir={dataset_dir}{% if uses_predicates %} external_predicates_file={predicates_path}{% endif %} output_data_dir={output_dir}/data do_overwrite=true
      meds-model pretrain input_data_dir={output_dir}/data output_pretrained_model_dir={output_dir}/pretrained
{% endif %}  supervised:
{% if profile in ['supervised', 'finetune', 'probe'] %}    train: |-
{% if profile == 'supervised' %}      meds-model preprocess_data external_meds_dir={dataset_dir}{% if uses_predicates %} external_predicates_file={predicates_path}{% endif %} output_data_dir={output_dir}/data do_overwrite=true
{% endif %}{% if profile == 'probe' %}      meds-model infer input_data_dir={model_initialization_dir}/data input_pretrained_model_dir={model_initialization_dir}/pretrained external_labels_dir={labels_dir} output_inference_subdir=inference/embeddings do_overwrite=true
      meds-model supervised_train input_data_dir={model_initialization_dir}/data external_labels_dir={labels_dir} input_inference_subdir=inference/embeddings output_supervised_model_dir={output_dir}/model
{% elif profile == 'finetune' %}      meds-model supervised_train input_data_dir={model_initialization_dir}/data external_labels_dir={labels_dir} input_pretrained_model_dir={model_initialization_dir}/pretrained output_supervised_model_dir={output_dir}/model
{% else %}      meds-model supervised_train input_data_dir={output_dir}/data external_labels_dir={labels_dir} output_supervised_model_dir={output_dir}/model
{% endif %}
{% else %}    train: null
{% endif %}    predict: |-
{% if profile == 'packaged' %}      meds-model preprocess_data external_meds_dir={dataset_dir}{% if uses_predicates %} external_predicates_file={predicates_path}{% endif %} output_data_dir={output_dir}/data do_overwrite=true
{% elif profile == 'zero_shot_materialized' %}      meds-model infer input_data_dir={model_initialization_dir}/data input_pretrained_model_dir={model_initialization_dir}/pretrained external_labels_dir={labels_dir} output_inference_subdir=inference/materialized do_overwrite=true
{% endif %}{% if profile in ['supervised', 'finetune', 'probe'] %}      meds-model predict input_supervised_model_dir={model_initialization_dir}/model external_labels_dir={labels_dir} splits=[{split}] output_predictions_dir={output_dir} do_overwrite=true
{% elif profile == 'zero_shot_materialized' %}      meds-model predict input_data_dir={model_initialization_dir}/data input_inference_subdir=inference/materialized external_labels_dir={labels_dir} splits=[{split}] output_predictions_dir={output_dir} do_overwrite=true
{% elif profile == 'zero_shot_direct' %}      meds-model predict input_pretrained_model_dir={model_initialization_dir}/pretrained external_labels_dir={labels_dir} splits=[{split}] output_predictions_dir={output_dir} do_overwrite=true
{% else %}      meds-model predict input_data_dir={output_dir}/data external_labels_dir={labels_dir} splits=[{split}] output_predictions_dir={output_dir} do_overwrite=true
{% endif %}
