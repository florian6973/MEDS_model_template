## MEDS-DEV model specification for {{ model_name }} (the {{ profile }} DAG).
##
## MEDS-DEV runs each command string in an isolated environment (built from `requirements.txt`) and fills
## the {curly} placeholders. Only `supervised.predict` is mandatory.
##
## Two facts about MEDS-DEV shape what follows:
##
##  * There is no preprocess slot, so `preprocess_data` is folded into the first command of each chain,
##    writing the shared workspace to {output_dir}/data.
##  * `{model_initialization_dir}` is a single rolling pointer: it becomes the most recent *training*
##    output. For a chain with both an unsupervised and a supervised train, that is not where the
##    workspace lives — so `predict` omits `input_data_dir` entirely and recovers it from its source
##    model's manifest, which recorded the workspace that model was trained on.
##
## `labels_dir` is available in every `supervised.*` slot (it is gated on dataset type, not on the slot),
## which is why no separate task-preparation step is needed: each command materializes what it needs.
metadata:
  description: "{{ model_description }}"
  contacts:
    - name: "{{ author_name }}"
      email: "{{ author_email }}"
  requirements: requirements.txt

commands:
{% if profile == 'supervised' %}  supervised:
    train: |-
      meds-model preprocess_data external_meds_dir={dataset_dir} output_data_dir={output_dir}/data do_overwrite=true
      meds-model supervised_train input_data_dir={output_dir}/data external_labels_dir={labels_dir} output_supervised_model_dir={output_dir}/model
    predict: |-
      meds-model predict input_supervised_model_dir={model_initialization_dir}/model external_labels_dir={labels_dir} splits=[{split}] output_predictions_dir={output_dir} do_overwrite=true
{% elif profile == 'finetune' %}  unsupervised:
    train: |-
      meds-model preprocess_data external_meds_dir={dataset_dir} output_data_dir={output_dir}/data do_overwrite=true
      meds-model pretrain input_data_dir={output_dir}/data output_pretrained_model_dir={output_dir}/pretrained
  supervised:
    train: |-
      meds-model supervised_train input_data_dir={model_initialization_dir}/data external_labels_dir={labels_dir} input_pretrained_model_dir={model_initialization_dir}/pretrained output_supervised_model_dir={output_dir}/model
    predict: |-
      meds-model predict input_supervised_model_dir={model_initialization_dir}/model external_labels_dir={labels_dir} splits=[{split}] output_predictions_dir={output_dir} do_overwrite=true
{% elif profile == 'probe' %}  unsupervised:
    train: |-
      meds-model preprocess_data external_meds_dir={dataset_dir} output_data_dir={output_dir}/data do_overwrite=true
      meds-model pretrain input_data_dir={output_dir}/data output_pretrained_model_dir={output_dir}/pretrained
  supervised:
    train: |-
      meds-model infer input_data_dir={model_initialization_dir}/data input_pretrained_model_dir={model_initialization_dir}/pretrained external_labels_dir={labels_dir} do_overwrite=true
      meds-model supervised_train input_data_dir={model_initialization_dir}/data external_labels_dir={labels_dir} input_inference_subdir=inference/embeddings output_supervised_model_dir={output_dir}/model
    predict: |-
      meds-model predict input_supervised_model_dir={model_initialization_dir}/model external_labels_dir={labels_dir} splits=[{split}] output_predictions_dir={output_dir} do_overwrite=true
{% elif profile == 'zero_shot_materialized' %}  unsupervised:
    train: |-
      meds-model preprocess_data external_meds_dir={dataset_dir} output_data_dir={output_dir}/data do_overwrite=true
      meds-model pretrain input_data_dir={output_dir}/data output_pretrained_model_dir={output_dir}/pretrained
  supervised:
    train: null
    predict: |-
      meds-model infer input_data_dir={model_initialization_dir}/data input_pretrained_model_dir={model_initialization_dir}/pretrained external_labels_dir={labels_dir} do_overwrite=true
      meds-model predict input_data_dir={model_initialization_dir}/data input_inference_subdir=inference/embeddings external_labels_dir={labels_dir} splits=[{split}] output_predictions_dir={output_dir} do_overwrite=true
{% elif profile == 'packaged' %}  unsupervised: null
  supervised:
    train: null
    predict: |-
      meds-model preprocess_data external_meds_dir={dataset_dir} output_data_dir={output_dir}/data do_overwrite=true
      meds-model predict input_data_dir={output_dir}/data external_labels_dir={labels_dir} splits=[{split}] output_predictions_dir={output_dir} do_overwrite=true
{% else %}  unsupervised:
    train: |-
      meds-model preprocess_data external_meds_dir={dataset_dir} output_data_dir={output_dir}/data do_overwrite=true
      meds-model pretrain input_data_dir={output_dir}/data output_pretrained_model_dir={output_dir}/pretrained
  supervised:
    train: null
    predict: |-
      meds-model predict input_pretrained_model_dir={model_initialization_dir}/pretrained external_labels_dir={labels_dir} splits=[{split}] output_predictions_dir={output_dir} do_overwrite=true
{% endif %}
