## MEDS-DEV model specification for {{ model_name }} (the {{ profile }} DAG).
##
## MEDS-DEV runs each command string in an isolated environment (built from `requirements.txt`) and fills
## the {curly} placeholders. Only `supervised.predict` is mandatory.
##
## Two impedance mismatches with the six-command interface, handled here rather than in the commands:
##
##  * MEDS-DEV has no preprocess slot, so `preprocess_data` is folded into each train command, writing the
##    shared workspace to {output_dir}/data.
##  * MEDS-DEV passes an already-materialized `labels_dir` rather than a task definition, so
##    `preprocess_task` is run over it with the `passed_through` path. Any boolean_value it carries is
##    dropped before prediction — this model never reads ground truth.
##
## Adjust placeholder names to match your MEDS-DEV version if needed.
metadata:
  description: "{{ model_description }}"
  contacts:
    - name: "{{ author_name }}"
      email: "{{ author_email }}"
  requirements: requirements.txt

commands:
{% if profile == 'supervised' %}  supervised:
    train: |-
      meds-model preprocess_data external_meds_dir={dataset_dir} output_data_dir={output_dir}/data do_overwrite=true
      meds-model preprocess_task input_data_dir={output_dir}/data external_task_file={labels_dir} do_overwrite=true
      meds-model supervised_train input_data_dir={output_dir}/data output_supervised_model_dir={output_dir}/model
    predict: |-
      meds-model predict input_data_dir={model_initialization_dir}/data input_supervised_model_dir={model_initialization_dir}/model splits=[{split}] output_predictions_dir={output_dir} do_overwrite=true
{% elif profile == 'finetune' %}  unsupervised:
    train: |-
      meds-model preprocess_data external_meds_dir={dataset_dir} output_data_dir={output_dir}/data do_overwrite=true
      meds-model pretrain input_data_dir={output_dir}/data output_pretrained_model_dir={output_dir}/pretrained
  supervised:
    train: |-
      meds-model preprocess_task input_data_dir={model_initialization_dir}/data external_task_file={labels_dir} do_overwrite=true
      meds-model supervised_train input_data_dir={model_initialization_dir}/data input_pretrained_model_dir={model_initialization_dir}/pretrained output_supervised_model_dir={output_dir}/model
    predict: |-
      meds-model predict input_data_dir={model_initialization_dir}/data input_supervised_model_dir={model_initialization_dir}/model splits=[{split}] output_predictions_dir={output_dir} do_overwrite=true
{% elif profile == 'probe' %}  unsupervised:
    train: |-
      meds-model preprocess_data external_meds_dir={dataset_dir} output_data_dir={output_dir}/data do_overwrite=true
      meds-model pretrain input_data_dir={output_dir}/data output_pretrained_model_dir={output_dir}/pretrained
  supervised:
    train: |-
      meds-model preprocess_task input_data_dir={model_initialization_dir}/data external_task_file={labels_dir} do_overwrite=true
      meds-model infer input_data_dir={model_initialization_dir}/data input_pretrained_model_dir={model_initialization_dir}/pretrained do_overwrite=true
      meds-model supervised_train input_data_dir={model_initialization_dir}/data input_inference_subdir=inference/embeddings output_supervised_model_dir={output_dir}/model
    predict: |-
      meds-model predict input_data_dir={model_initialization_dir}/data input_supervised_model_dir={model_initialization_dir}/model splits=[{split}] output_predictions_dir={output_dir} do_overwrite=true
{% elif profile == 'zero_shot_materialized' %}  unsupervised:
    train: |-
      meds-model preprocess_data external_meds_dir={dataset_dir} output_data_dir={output_dir}/data do_overwrite=true
      meds-model pretrain input_data_dir={output_dir}/data output_pretrained_model_dir={output_dir}/pretrained
  supervised:
    predict: |-
      meds-model preprocess_task input_data_dir={model_initialization_dir}/data external_task_file={labels_dir} do_overwrite=true
      meds-model infer input_data_dir={model_initialization_dir}/data input_pretrained_model_dir={model_initialization_dir}/pretrained do_overwrite=true
      meds-model predict input_data_dir={model_initialization_dir}/data input_inference_subdir=inference/embeddings splits=[{split}] output_predictions_dir={output_dir} do_overwrite=true
{% elif profile == 'packaged' %}  supervised:
    predict: |-
      meds-model preprocess_data external_meds_dir={dataset_dir} output_data_dir={output_dir}/data do_overwrite=true
      meds-model preprocess_task input_data_dir={output_dir}/data external_task_file={labels_dir} do_overwrite=true
      meds-model predict input_data_dir={output_dir}/data splits=[{split}] output_predictions_dir={output_dir} do_overwrite=true
{% else %}  unsupervised:
    train: |-
      meds-model preprocess_data external_meds_dir={dataset_dir} output_data_dir={output_dir}/data do_overwrite=true
      meds-model pretrain input_data_dir={output_dir}/data output_pretrained_model_dir={output_dir}/pretrained
  supervised:
    predict: |-
      meds-model preprocess_task input_data_dir={model_initialization_dir}/data external_task_file={labels_dir} do_overwrite=true
      meds-model predict input_data_dir={model_initialization_dir}/data input_pretrained_model_dir={model_initialization_dir}/pretrained splits=[{split}] output_predictions_dir={output_dir} do_overwrite=true
{% endif %}
