#!/usr/bin/env bash
#SBATCH --job-name=meds-model
set -euo pipefail

: "${MEDS_MODEL_COMMAND:?MEDS_MODEL_COMMAND is required}"
: "${RUN_ID:?RUN_ID is required}"
: "${MEDS_MODEL_ARGS_FILE:?MEDS_MODEL_ARGS_FILE is required}"

mapfile -t model_args < "$MEDS_MODEL_ARGS_FILE"
meds-model "$MEDS_MODEL_COMMAND" "${model_args[@]}" "$@"
