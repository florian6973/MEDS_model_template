"""Small backend-neutral command dispatcher."""

import json
import sys

from meds_model_contract import ModelRepository

from .commands import COMMANDS

REPOSITORY = ModelRepository("{{ profile }}", COMMANDS)


def _value(text: str):
    try:
        return json.loads(text)
    except json.JSONDecodeError:
        return text


def main() -> None:
    if len(sys.argv) < 2 or sys.argv[1] in {"-h", "--help"}:
        print("usage: meds-model <command|commands> [key=value ...]")
        return
    if sys.argv[1] == "commands":
        print("\n".join(command.value for command in REPOSITORY.dag))
        return
    arguments = {}
    for item in sys.argv[2:]:
        if "=" not in item:
            raise SystemExit(f"Expected key=value, got {item!r}")
        key, value = item.split("=", 1)
        arguments[key] = _value(value)
    REPOSITORY.run(sys.argv[1], arguments)


if __name__ == "__main__":
    main()
