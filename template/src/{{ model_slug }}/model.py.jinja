"""The model — yours to own. Rendered once for the ``{{ profile }}`` profile, then never touched again.

``copier update`` refreshes the vendored contract in ``meds_model_base`` but leaves this file alone, so
edit it freely: change the encoder, add layers, swap the loss, rewrite it entirely. The commands only
require that what comes out is a ``LightningModule`` implementing the hooks below.

- ``compute_loss(batch) -> (loss, metrics)`` — training. Called by both training commands.
- ``predict_step(batch) -> dict`` — task probabilities, consumed by ``predict``.
- ``infer_step(batch) -> dict`` + ``inference_kind`` — reusable per-timepoint artifacts, consumed by
  ``infer``. ``BaseLightningModule`` defaults these to the pooled representation from ``encode``.

``meds_model_base.lightning.modules`` supplies only the pieces that must know the MEDS batch format —
``CodeEmbedder``, ``padding_mask``, ``masked_mean``. Everything else below is ordinary PyTorch.
"""

from collections.abc import Callable

{% if profile == 'probe' %}import lightning.pytorch as L
{% endif %}import torch
import torch.nn.functional as F
from meds_model_base.lightning.modules import (
    PAD_INDEX,
    BaseLightningModule,
    CodeEmbedder,
    masked_mean,
    padding_mask,
)
from meds_torchdata import MEDSTorchBatch
from torch import Tensor, nn
{% if profile == 'zero_shot_ar' %}

class Model(BaseLightningModule):
    """An autoregressive "everything-is-code" causal LM over MEDS token sequences.

    Trained with next-code cross-entropy. ``infer`` materializes sampled futures as ``trajectories``; a
    task is resolved over those futures in ``predict.py``.

    Deliberately compact rather than performance-tuned: it generates codes only and does not special-case
    EOS the way a production autoregressive model would.

    Args:
        vocab_size: code-vocabulary size (injected from ``datamodule.config.vocab_size``).
        d_model, nhead, num_layers, dropout: Transformer size.
        max_seq_len: maximum context length (for the learned positional embedding).
        max_new_tokens: number of codes to generate per subject at inference.
        optimizer / scheduler: Hydra ``_partial_`` factories.
    """

    inference_kind = "trajectories"

    def __init__(
        self,
        vocab_size: int,
        d_model: int = 128,
        nhead: int = 4,
        num_layers: int = 2,
        dropout: float = 0.1,
        max_seq_len: int = 256,
        max_new_tokens: int = 32,
        optimizer: Callable | None = None,
        scheduler: Callable | None = None,
    ) -> None:
        super().__init__(optimizer=optimizer, scheduler=scheduler)
        self.save_hyperparameters(ignore=["optimizer", "scheduler"])

        self.vocab_size = vocab_size
        self.max_new_tokens = max_new_tokens
        self.embed = nn.Embedding(vocab_size, d_model, padding_idx=PAD_INDEX)
        self.pos = nn.Embedding(max_seq_len, d_model)
        layer = nn.TransformerEncoderLayer(
            d_model, nhead, dim_feedforward=4 * d_model, dropout=dropout, batch_first=True, norm_first=True
        )
        self.blocks = nn.TransformerEncoder(layer, num_layers=num_layers)
        self.ln = nn.LayerNorm(d_model)
        self.lm_head = nn.Linear(d_model, vocab_size)

    def _hidden(self, codes: Tensor) -> Tensor:
        seq_len = codes.shape[1]
        positions = torch.arange(seq_len, device=codes.device)
        x = self.embed(codes) + self.pos(positions).unsqueeze(0)
        causal = nn.Transformer.generate_square_subsequent_mask(seq_len, device=codes.device)
        pad = codes == PAD_INDEX
        return self.ln(self.blocks(x, mask=causal, src_key_padding_mask=pad, is_causal=True))

    def forward(self, codes: Tensor) -> Tensor:
        """Next-code logits ``[B, L, vocab_size]``."""
        return self.lm_head(self._hidden(codes))

    def compute_loss(self, batch: MEDSTorchBatch) -> tuple[Tensor, dict[str, Tensor]]:
        codes = batch.code
        logits = self(codes[:, :-1])
        target = codes[:, 1:]
        loss = F.cross_entropy(
            logits.reshape(-1, self.vocab_size), target.reshape(-1), ignore_index=PAD_INDEX
        )
        return loss, {}

    @torch.no_grad()
    def generate(self, codes: Tensor, max_new_tokens: int, sample: bool = False) -> Tensor:
        """Extend each row of ``codes`` by ``max_new_tokens`` (``[B, L] -> [B, L + T]``).

        Sampling rather than greedy decoding is what makes a zero-shot *probability* meaningful: a greedy
        trajectory can only ever answer 0 or 1.
        """
        max_ctx = self.pos.num_embeddings
        for _ in range(max_new_tokens):
            logits = self(codes[:, -max_ctx:])[:, -1]
            if sample:
                next_code = torch.multinomial(F.softmax(logits, dim=-1), num_samples=1)
            else:
                next_code = logits.argmax(dim=-1, keepdim=True)
            codes = torch.cat([codes, next_code], dim=1)
        return codes

    def infer_step(self, batch: MEDSTorchBatch) -> dict[str, Tensor]:
        """Generated futures, published as an inference artifact of kind ``trajectories``."""
        return {"generated_codes": self.generate(batch.code, self.max_new_tokens).detach().cpu()}

    def predict_step(self, batch: MEDSTorchBatch, batch_idx: int = 0) -> dict[str, Tensor]:
        """Same generations as :meth:`infer_step`, for a ``predict`` that resolves a task in-process."""
        return self.infer_step(batch)
{% elif profile == 'every_query' %}

class Model(BaseLightningModule):
    """A query-conditioned pretrained model: an encoder plus a multi-label code-occurrence head.

    Pretraining predicts which codes occur in a subject's timeline — a simplified proxy for EveryQuery's
    "does code X occur within horizon" objective. At ``predict`` the task is translated into a code query
    and that code's occurrence probability is read off (see ``predict.py``).

    Args:
        vocab_size: code-vocabulary size (injected from ``datamodule.config.vocab_size``).
        d_model: hidden size.
        num_layers: GRU depth.
        dropout: GRU dropout (applies with more than one layer).
        use_numeric_value: fold numeric values into the embedding.
        optimizer / scheduler: Hydra ``_partial_`` factories.
    """

    #: `infer` materializes per-code occurrence probabilities, not embeddings.
    inference_kind = "scores"

    def __init__(
        self,
        vocab_size: int,
        d_model: int = 64,
        num_layers: int = 1,
        dropout: float = 0.1,
        use_numeric_value: bool = True,
        optimizer: Callable | None = None,
        scheduler: Callable | None = None,
    ) -> None:
        super().__init__(optimizer=optimizer, scheduler=scheduler)
        self.save_hyperparameters(ignore=["optimizer", "scheduler"])

        self.vocab_size = vocab_size
        self.embedder = CodeEmbedder(vocab_size, d_model, use_numeric_value=use_numeric_value)
        self.encoder = nn.GRU(
            d_model,
            d_model,
            num_layers=num_layers,
            batch_first=True,
            dropout=dropout if num_layers > 1 else 0.0,
        )
        self.query_head = nn.Linear(d_model, vocab_size)  # per-code occurrence logits

    def encode(self, batch: MEDSTorchBatch) -> Tensor:
        """Pooled ``[B, d_model]`` subject representation."""
        mask = padding_mask(batch)
        hidden, _ = self.encoder(self.embedder(batch))
        return masked_mean(hidden, mask)

    def occurrence_logits(self, batch: MEDSTorchBatch) -> Tensor:
        """Per-code occurrence logits ``[B, vocab_size]``."""
        return self.query_head(self.encode(batch))

    def compute_loss(self, batch: MEDSTorchBatch) -> tuple[Tensor, dict[str, Tensor]]:
        logits = self.occurrence_logits(batch)
        target = _multi_hot(batch.code, self.vocab_size)
        return F.binary_cross_entropy_with_logits(logits, target), {}

    def infer_step(self, batch: MEDSTorchBatch) -> dict[str, Tensor]:
        """The full occurrence-probability vector, so any code can be queried later."""
        return {"query_probs": torch.sigmoid(self.occurrence_logits(batch)).detach().cpu()}

    def predict_step(self, batch: MEDSTorchBatch, batch_idx: int = 0) -> dict[str, Tensor]:
        """Per-code occurrence probabilities ``[B, vocab_size]`` — query any code downstream."""
        return self.infer_step(batch)


def _multi_hot(codes: Tensor, vocab_size: int) -> Tensor:
    """Build a ``[B, vocab_size]`` multi-hot of which (non-pad) codes appear in each row of ``codes``."""
    target = torch.zeros(codes.shape[0], vocab_size, device=codes.device)
    target.scatter_(1, codes.clamp(min=0), 1.0)
    target[:, PAD_INDEX] = 0.0
    return target
{% elif profile == 'motor_finetune' %}

class Model(BaseLightningModule):
    """A MOTOR-style model: one module, two objectives, selected by whether the batch carries labels.

    - **``pretrain`` (no labels)** — time-to-event: from each position's contextual state, predict the gap
      to the next measurement under an exponential hazard (NLL). This teaches the encoder the temporal
      structure of a timeline, which is the essence of MOTOR.
    - **``supervised_train`` (labels present)** — a classification head on the pooled representation,
      warm-started from the pretrained encoder. The embedder and encoder transfer; the head is fresh.

    A warm start that matches no parameters raises rather than silently training from scratch, so a
    renamed encoder is a loud failure instead of a quietly different experiment.

    Args:
        vocab_size: code-vocabulary size (injected from ``datamodule.config.vocab_size``).
        d_model: hidden size.
        num_layers: GRU depth.
        dropout: GRU dropout (applies with more than one layer).
        use_numeric_value: fold numeric values into the embedding.
        threshold: probability threshold for the optional ``predicted_boolean_value`` column.
        optimizer / scheduler: Hydra ``_partial_`` factories.
    """

    def __init__(
        self,
        vocab_size: int,
        d_model: int = 64,
        num_layers: int = 1,
        dropout: float = 0.1,
        use_numeric_value: bool = True,
        threshold: float = 0.5,
        optimizer: Callable | None = None,
        scheduler: Callable | None = None,
    ) -> None:
        super().__init__(optimizer=optimizer, scheduler=scheduler)
        self.save_hyperparameters(ignore=["optimizer", "scheduler"])

        self.embedder = CodeEmbedder(vocab_size, d_model, use_numeric_value=use_numeric_value)
        self.encoder = nn.GRU(
            d_model,
            d_model,
            num_layers=num_layers,
            batch_first=True,
            dropout=dropout if num_layers > 1 else 0.0,
        )
        self.tte_head = nn.Linear(d_model, 1)  # log-rate of an exponential time-to-next-event
        self.cls_head = nn.Linear(d_model, 1)  # supervised classification
        self.threshold = threshold

    def _sequence(self, batch: MEDSTorchBatch) -> Tensor:
        hidden, _ = self.encoder(self.embedder(batch))
        return hidden

    def encode(self, batch: MEDSTorchBatch) -> Tensor:
        """Pooled subject representation — also what ``infer`` materializes as embeddings."""
        return masked_mean(self._sequence(batch), padding_mask(batch))

    def compute_loss(self, batch: MEDSTorchBatch) -> tuple[Tensor, dict[str, Tensor]]:
        if batch.has_labels:
            logits = self.cls_head(self.encode(batch)).squeeze(-1)
            target = batch.boolean_value.to(logits.dtype)
            loss = F.binary_cross_entropy_with_logits(logits, target)
            with torch.no_grad():
                acc = ((logits > 0).to(target.dtype) == target).float().mean()
            return loss, {"acc": acc, "mode_classify": torch.ones((), device=loss.device)}

        # Time-to-event pretraining: predict the gap to the next measurement (exponential NLL).
        hidden = self._sequence(batch)
        rate = F.softplus(self.tte_head(hidden[:, :-1]).squeeze(-1)) + 1e-4
        # log1p-compress the day-scale gaps so the exponential NLL stays well-conditioned across the wide
        # dynamic range of inter-event times (minutes to years).
        target_dt = torch.log1p(torch.clamp(torch.nan_to_num(batch.time_delta_days[:, 1:]), min=0.0))
        mask = padding_mask(batch)[:, 1:].to(rate.dtype)
        nll = (-torch.log(rate) + rate * target_dt) * mask
        loss = nll.sum() / mask.sum().clamp(min=1.0)
        return loss, {"mode_tte": torch.ones((), device=loss.device)}

    def predict_step(self, batch: MEDSTorchBatch, batch_idx: int = 0) -> dict[str, Tensor]:
        probs = torch.sigmoid(self.cls_head(self.encode(batch)).squeeze(-1))
        return {
            "predicted_boolean_probability": probs.detach().cpu(),
            "predicted_boolean_value": (probs > self.threshold).detach().cpu(),
        }
