# @package _global_
# supervised_train: train a task model, from scratch or on top of at most ONE prior artifact.
# input_pretrained_model_dir and input_inference_subdir are alternatives, not layers: supplying both is
# an error rather than a precedence decision.
defaults:
  - paths: default
  - datamodule: task
{% if profile == 'probe' %}  # This profile trains a head on frozen embeddings, so `model` here is the probe, not the encoder.
  - model: probe
{% else %}  - model: default
{% endif %}  - trainer: default
  - callbacks: default
  - logger: csv
  - optimizer: adamw
  - _self_
  - profile: default

input_data_dir: ${data_dir}
input_task_subdir: ${tasks.default}
output_supervised_model_dir: ${models.supervised}

#: Optional, mutually exclusive sources.
input_pretrained_model_dir: null
input_inference_subdir: null

max_seq_len: 256
batch_size: 32
num_workers: 0
seed: 0

do_overwrite: false
do_resume: true
work_dir: null
clean_work_dir: true

hydra:
  run: {dir: "${log_dir}/supervised_train"}
  job: {chdir: false}
