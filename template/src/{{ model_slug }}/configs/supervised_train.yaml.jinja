# @package _global_
# supervised_train: train a task model, from scratch or on top of at most ONE prior artifact.
# input_pretrained_model_dir and input_inference_subdir are alternatives, not layers: supplying both is
# an error rather than a precedence decision.
defaults:
  - paths: default
  - datamodule: task
{% if profile == 'probe' %}  # This DAG trains a head on frozen embeddings, so `model` here is the probe, not the encoder.
  - model: probe
{% else %}  - model: default
{% endif %}  - trainer: default
  - callbacks: default
  - logger: csv
  - optimizer: adamw
  - _self_
  - profile: default

input_data_dir: ${data_dir}

#: A MEDS labels directory: any arrangement of *.parquet carrying
#: (subject_id, prediction_time, boolean_value). `meds-dev-task` writes train/0.parquet,
#: tuning/0.parquet, held_out/0.parquet -- those names are input *shard* names, not splits, and are
#: not read as such: which split a subject belongs to comes from the tokenized cohort in
#: input_data_dir. Dot-directories (meds-dev-task's .logs/) are skipped.
external_labels_dir: ???

output_supervised_model_dir: ${models.supervised}

#: Optional, mutually exclusive sources.
input_pretrained_model_dir: null
input_inference_subdir: null

max_seq_len: 256
batch_size: 32
num_workers: 0
seed: 0

do_overwrite: false
#: Resume from an interrupted run's work directory (not from a published artifact). Off by default: the
#: work directory is derived from the output path alone, so nothing checks that the checkpoint in it came
#: from this config, task or dataset, and `ckpt_path` restores optimizer state, LR-schedule position and
#: the epoch counter with the weights. Scratch lives at `<output_dir>.work` and is removed once the
#: artifact is published, so a checkpoint survives only a crash — exactly when the config gets changed
#: before the re-run. Turn this on to continue the *same* run; a changed config needs a fresh one.
do_resume: false

hydra:
  run: {dir: "${log_dir}/supervised_train"}
  job: {chdir: false}
