# The probe head trained on frozen embeddings. Selected by supervised_train (`model: probe`), which
# injects `input_dim` from the width of the materialized embeddings.
_target_: {{ model_slug }}.model.Probe
hidden_size: 0      # 0 == a linear probe; set a width for one hidden layer
dropout: 0.0
lr: 0.001
threshold: 0.5
