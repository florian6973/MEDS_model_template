def test_generation_is_in_grammar(cli, tmp_path):
    """After LM pretraining on a fixed-program grammar, greedy generation stays in the code vocabulary."""
    import torch
    from meds_torchdata import MEDSPytorchDataset, MEDSTorchDataConfig
    from meds_torchdata.types import SubsequenceSamplingStrategy

    from meds_model_base.testing.synthetic import build_pattern_dataset
    from meds_model_base.utils import require_checkpoint

    from {{ model_slug }}.model import Model

    raw = build_pattern_dataset(tmp_path / "raw", seed=0)
    data_dir = tmp_path / "data"
    cli([
        "preprocess_data",
        f"external_meds_dir={raw}",
        f"output_data_dir={data_dir}",
        "do_reshard=true",
        "do_overwrite=true",
    ])
    pretrained_dir = tmp_path / "pretrained"
    cli([
        "pretrain",
        f"input_data_dir={data_dir}",
        f"output_pretrained_model_dir={pretrained_dir}",
        "trainer.max_epochs=30",
        "max_seq_len=64",
        *_TRAIN,
    ])

    model = Model.load_from_checkpoint(require_checkpoint(pretrained_dir), map_location="cpu").eval()
    cfg = MEDSTorchDataConfig(
        tensorized_cohort_dir=str(data_dir / "patients"),
        max_seq_len=32,
        seq_sampling_strategy=SubsequenceSamplingStrategy.FROM_START,
    )
    ds = MEDSPytorchDataset(cfg, split="held_out")
    batch = next(iter(ds.get_dataloader(batch_size=8, shuffle=False)))
    with torch.no_grad():
        generated = model.generate(batch.code[:, :4], max_new_tokens=16)

    # Learnability: greedy continuations should be real (non-pad) vocab codes far more often than a random
    # baseline (uniform over the vocab would be ~1/vocab_size per position).
    new_tokens = generated[:, 4:]
    valid_fraction = (new_tokens > 0).float().mean().item()
    assert valid_fraction >= 0.9, f"AR generation produced too many pad tokens ({valid_fraction:.2f})"
