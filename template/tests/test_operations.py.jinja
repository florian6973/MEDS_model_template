import os
import subprocess
from pathlib import Path

import yaml

from meds_model_contract import MODEL_PROFILES


ROOT = Path(__file__).parents[1]


def test_model_yaml_is_a_meds_dev_descriptor():
    descriptor = yaml.safe_load((ROOT / "model.yaml").read_text())
    assert set(descriptor) == {"metadata", "commands"}
    assert "supervised" in descriptor["commands"]
    assert descriptor["commands"]["supervised"]["predict"]


def test_slurm_dry_run_is_non_mutating():
    before = {p.relative_to(ROOT) for p in ROOT.rglob("*")}
    result = subprocess.run(
        ["bash", "slurm/submit.sh", "--dry-run"],
        cwd=ROOT,
        text=True,
        capture_output=True,
        check=True,
        env={**os.environ, "PYTHONDONTWRITEBYTECODE": "1"},
    )
    after = {p.relative_to(ROOT) for p in ROOT.rglob("*")}
    assert before == after
    for command in MODEL_PROFILES["{{ profile }}"]:
        assert command.value in result.stdout
    assert "sbatch" in result.stdout
