"""Tier 2 — end-to-end conformance: does this model's DAG actually run?

Drives the chain this model registers over a tiny real MEDS dataset and asserts the ``predict`` output
conforms to ``meds_evaluation.PredictionSchema`` — the load-bearing compatibility check with the shared
evaluation tool.

**This is the contract your model has to satisfy, not scaffolding to delete.** The parts that need a model
skip while ``model.py`` is the generated stub, and start running as soon as you remove the ``is_stub``
marker. The parts that don't — the workspace, the manifests, argument arbitration — run from day one.
"""

import polars as pl
import pytest
import yaml
from meds_evaluation.schema import PredictionSchema
from meds_model_base.commands import CommandName
from meds_model_base.tasks import tokenized_cohort
from meds_model_base.testing import skip_if_stub

from {{ model_slug }}.commands import COMMANDS
from {{ model_slug }}.model import Model


def test_workspace_is_published_with_manifests(data_dir):
    """preprocess_data publishes a self-describing artifact. No model involved."""
    patients = yaml.safe_load((data_dir / "patients" / "manifest.yaml").read_text())
    assert patients["artifact"]["type"] == "data"
    assert patients["command"] == "preprocess_data"

    # Split membership must travel with the artifact, since every command that materializes labels needs
    # it and nothing downstream may depend on the raw MEDS directory still existing. It travels as the
    # shard layout, which is where meds-torch-data reads it from, rather than as a copy of the source
    # dataset's subject_splits.parquet -- a copy describes the input to preprocessing, and a pipeline
    # that filters subjects makes those two different things.
    assert set(tokenized_cohort(data_dir / "patients"))
    assert not (data_dir / "patients" / "metadata" / "subject_splits.parquet").exists()

    # Counted from the artifact, so a filtering pipeline shows up here rather than being invisible.
    assert patients["splits"] == {
        split: len(subjects) for split, subjects in sorted(tokenized_cohort(data_dir / "patients").items())
    }


def test_inference_never_sees_ground_truth(data_dir, labels_dir, tmp_path):
    """At inference, the labels are not merely dropped from the output — they never reach the model.

    `predict` and `infer` materialize the index without `boolean_value`. meds-torch-data distinguishes a
    task *index* from task *labels*, so the batch handed to `predict_step` has no `boolean_value` at all,
    and a model cannot read the answer it is about to be scored against even by accident.

    Training is the opposite case and is checked here too, so the difference is deliberate rather than
    incidental. Needs no model.
    """
    from meds_model_base.tasks import materialize_labels
    from meds_torchdata import MEDSPytorchDataset, MEDSTorchDataConfig
    from meds_torchdata.types import SubsequenceSamplingStrategy

    patients = data_dir / "patients"

    for include_labels, expect_labels in [(False, False), (True, True)]:
        dest = tmp_path / f"labels_{include_labels}"
        materialize_labels(labels_dir, patients, dest, include_labels=include_labels)

        written = pl.read_parquet(dest / "held_out.parquet")
        assert ("boolean_value" in written.columns) is expect_labels

        dataset = MEDSPytorchDataset(
            MEDSTorchDataConfig(
                tensorized_cohort_dir=str(patients),
                max_seq_len=32,
                task_labels_dir=str(dest),
                # meds-torch-data rejects any other strategy whenever task_labels_dir is set. Note it
                # is not what enforces the as-of cutoff — `end_event_index` already bounds the window
                # to events at or before prediction_time. TO_END only decides *which* of that allowed
                # history you get: the most recent max_seq_len events rather than an earlier slice.
                seq_sampling_strategy=SubsequenceSamplingStrategy.TO_END,
            ),
            split="held_out",
        )
        assert dataset.has_task_index, "the timepoints must always reach the model"
        assert dataset.has_task_labels is expect_labels


def test_conflicting_sources_are_rejected(data_dir, labels_dir, tmp_path):
    """Two prediction sources is an error, not a precedence decision. Needs no model."""
    if CommandName.predict not in COMMANDS or len(COMMANDS[CommandName.predict].sources) < 2:
        pytest.skip("this model's predict command has fewer than two possible sources")

    import subprocess

    result = subprocess.run(
        [
            "meds-model",
            "predict",
            f"input_data_dir={data_dir}",
            f"external_labels_dir={labels_dir}",
            "input_supervised_model_dir=/nonexistent/supervised",
            "input_pretrained_model_dir=/nonexistent/pretrained",
            f"output_predictions_dir={tmp_path / 'never'}",
        ],
        capture_output=True,
        text=True,
    )
    assert result.returncode != 0
    assert "more than one input source" in (result.stdout + result.stderr)


def test_end_to_end(chain, data_dir, labels_dir, tmp_path):
    skip_if_stub(Model)
    artifacts = chain(data_dir, labels_dir, tmp_path)

    for role in ("pretrained", "supervised"):
        if role in artifacts:
            assert (artifacts[role] / "manifest.yaml").is_file(), f"{role} artifact has no manifest"

    if "inference" in artifacts:
        manifest = yaml.safe_load((artifacts["inference"] / "manifest.yaml").read_text())
        # The kind is what makes an inference artifact safely consumable downstream.
        assert manifest["artifact"]["kind"]
        assert (artifacts["inference"] / "artifacts.parquet").is_file()

    if "predictions" not in artifacts:
        return

    preds_dir = artifacts["predictions"]
    preds = pl.read_parquet(preds_dir / "predictions.parquet")
    # The contract: the model's output is scorable by the shared meds-evaluation tool.
    PredictionSchema.align(preds.to_arrow())
    assert "predicted_boolean_probability" in preds.columns
    assert {"subject_id", "prediction_time"}.issubset(preds.columns)
    # The ground truth is joined back on *after* the model ran: meds-evaluation scores a predictions file
    # in isolation and rejects one without `boolean_value`. That the model itself never saw it is a
    # separate property, checked by test_inference_never_sees_ground_truth above.
    assert "boolean_value" in preds.columns

    manifest = yaml.safe_load((preds_dir / "manifest.yaml").read_text())
    coverage = manifest["coverage"]["held_out"]
    assert coverage["n_written"] == coverage["n_expected"] == len(preds)
