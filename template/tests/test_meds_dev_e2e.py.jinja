"""Run this completed repository through MEDS-DEV's isolated model environment."""

from pathlib import Path

import pytest

from meds_model_contract.meds_dev import register
from {{ model_slug }}.commands import IS_STUB

from .integration import RUN_TIMEOUT, assert_prediction_keys, provision_meds_dev, run, venv_bin

pytestmark = [pytest.mark.slow, pytest.mark.meds_dev]
ROOT = Path(__file__).parents[1]
MODEL_NAME = "{{ model_slug }}"


@pytest.fixture(scope="session")
def meds_dev(request, tmp_path_factory):
    if IS_STUB:
        pytest.skip("model_stub: MEDS-DEV runs only after the real model profile is implemented")
    return provision_meds_dev(request, tmp_path_factory)


def test_meds_dev_runs_model_yaml(meds_dev, tmp_path):
    import polars as pl
    import yaml
    from meds_evaluation.schema import PredictionSchema

    from .e2e import prepare_meds_dev_run

    registered = register(ROOT, meds_dev, MODEL_NAME)
    assert (registered / "model.yaml").is_file()
    prepared = prepare_meds_dev_run(meds_dev, tmp_path)
    run([venv_bin(meds_dev) / "meds-dev-model", f"model={MODEL_NAME}", *prepared.args], timeout=RUN_TIMEOUT)

    predictions_file = prepared.predictions_dir / "predictions.parquet"
    predictions = pl.read_parquet(predictions_file)
    PredictionSchema.align(predictions.to_arrow())
    assert predictions.height > 0
    assert predictions.select("subject_id", "prediction_time").unique().height == predictions.height
    manifest = yaml.safe_load((prepared.predictions_dir / "manifest.yaml").read_text())
    assert manifest["artifact"]["type"] == "predictions"
    assert_prediction_keys(prepared.predictions_dir, prepared.labels_dir, prepared.splits)
    assert manifest["resources"]["memory"]["peak_process_tree_rss_bytes"] > 0
